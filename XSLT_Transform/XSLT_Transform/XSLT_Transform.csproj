    </None>
    <None Update="Xslt\JsonXmlSOTransform.xslt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Xslt\SalesOrderAckTransform.xslt">
